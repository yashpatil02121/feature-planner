{
  // Keep lint focused on structure, not prose style.
  "config": {
    "default": true,
    "MD013": false, // line length: prose and tables wrap naturally
    "MD024": { "siblings_only": true }, // repeated headings like "In Scope" under different parents
    "MD033": false, // inline HTML
    "MD041": false, // first line need not be an H1 (plan template starts with front matter)
    "MD060": false // table column alignment
  },
  "globs": ["**/*.md"],
  "ignores": ["**/node_modules/**", "**/evals/results/**"]
}
